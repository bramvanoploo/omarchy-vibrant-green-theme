{
  "spec": {
    "version": 2,
    "preset": "float",
    "engine": "omagen",
    "topology": "floating",
    "position": "top",
    "surface": {
      "treatment": "glass",
      "role": "background",
      "opacity": 0.82,
      "blur": 12,
      "border_role": "accent",
      "border_opacity": 0.35,
      "border_width": 1,
      "shadow": "floating"
    },
    "geometry": {
      "density": "compact",
      "thickness": 0,
      "edge_offset": 8,
      "outer_margin": 8,
      "inner_padding": 0,
      "section_gap": 8,
      "widget_gap": 0,
      "radius": 14,
      "length_mode": "full",
      "length_value": 0,
      "alignment": "center"
    },
    "attention": {
      "mode": "semantic"
    },
    "behavior": {
      "visibility": "always",
      "exclusive_zone": "reserve",
      "hover_expand": false,
      "hide_delay_ms": 5000,
      "reveal_delay_ms": 50,
      "edge_sensor": 3,
      "keep_visible_while_popup_open": true
    },
    "regions": {
      "left": {
        "mode": "native"
      },
      "center": {
        "mode": "native"
      },
      "right": {
        "mode": "native"
      }
    },
    "workspace": {
      "mode": "dots"
    },
    "clock": {
      "style": "native"
    },
    "dock": {
      "closed": "ellipsis",
      "glyph": "✦"
    },
    "motion": {
      "preset": "smooth",
      "duration_ms": 220,
      "easing": "out_cubic"
    }
  },
  "engine": "omagen",
  "native": false,
  "capabilities": {
    "surface": false,
    "topology": false,
    "behavior": true,
    "regions": true,
    "workspace": false,
    "clock": true
  }
}
